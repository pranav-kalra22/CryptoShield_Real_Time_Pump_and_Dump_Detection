# ──────────────────────────────────────────────────────────
# CryptoShield — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ──────────────────────────────────────────────────────────

# Kafka Configuration
KAFKA_BROKER=localhost:9092
TOPIC_SOCIAL=social_interactions
TOPIC_PRICE=price_feed

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=crypto_shield
MONGO_ALERTS_COLLECTION=alerts
MONGO_METRICS_COLLECTION=metrics

# Detection Thresholds
CLIQUE_MIN_SIZE=5
CLIQUE_DENSITY_THRESH=0.6
STAR_MIN_DEGREE=10
STAR_DEGREE_RATIO=0.8

# Realtime Producer Configuration
COINGECKO_POLL_INTERVAL=30
PRICE_SPIKE_THRESHOLD=0.2
SOCIAL_BURST_SIZE=25

# Streamlit Dashboard Configuration
DASHBOARD_REFRESH_SEC=5
